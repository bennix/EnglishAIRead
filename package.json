{
  "name": "folio-english-reader",
  "version": "1.0.5",
  "private": true,
  "description": "Folio — AI-assisted English reading with ZenMux",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac dmg zip --win nsis --linux AppImage deb rpm",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:electron": "npm run build && node tests/electron-smoke.cjs"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "^0.4.6",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.7",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.folio.englishreader",
    "productName": "Folio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "timestamp": "http://timestamp.apple.com/ts01",
      "signIgnore": [
        ".*\\.pak$"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "resources/icon.png",
      "category": "Education",
      "maintainer": "Folio"
    }
  },
  "author": "Folio"
}
